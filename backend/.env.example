# PostgreSQL Connection String (Use IPv4 Supavisor Pooler URL for Vercel/Serverless)
# Format: postgresql://<username>.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.ezdijbujbydtlwfpwdyo:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Set to true to automatically fall back to local SQLite during development if PostgreSQL server is not yet running
AUTO_SQLITE_FALLBACK=true

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://liver-care-ten.vercel.app
