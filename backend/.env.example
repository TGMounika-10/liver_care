# PostgreSQL Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/livercare_db

# Set to true to automatically fall back to local SQLite during development if PostgreSQL server is not yet running
AUTO_SQLITE_FALLBACK=true

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

